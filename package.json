{
  "type": "module",
  "scripts": {
    "format": "prettier -w .",
    "build": "npm run build:params && node scripts/buildTemplate.js",
    "build:params": "npx tsx scripts/buildParameters.js",
    "test:tools": "node --test 'tools/**/*.test.js'",
    "migrate-consent-triggers": "node tools/consent-trigger-migration/cli.js",
    "build:test": "npm run build && node scripts/diffTest.js tmp/parameters_original.json src/parameters.json; diff tmp/old.canon.json tmp/new.canon.json"
  },
  "devDependencies": {
    "playwright-core": "1.59.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4"
  }
}
